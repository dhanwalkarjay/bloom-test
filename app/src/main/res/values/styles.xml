<!-- res/values/styles.xml -->
<resources>

    <style name="Bloom" />
    <style name="Bloom.Button" />
    <style name="Bloom.Chip" />

    <!-- Primary button - matches the rounded rose-pink button used throughout the customer app -->
    <style name="Bloom.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/bloom_primary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Outlined secondary button -->
    <style name="Bloom.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/bloom_primary</item>
        <item name="android:textColor">@color/bloom_primary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_height">@dimen/button_height</item>
    </style>

    <!-- Card style used for shop cards, product cards, order cards -->
    <style name="Bloom.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/bloom_card_stroke</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Status chip base -->
    <style name="Bloom.Chip.Status" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/radius_chip</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="chipMinHeight">28dp</item>
    </style>

    <!-- Text styles -->
    <style name="Bloom.Text" />

    <style name="Bloom.Text.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/bloom_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Bloom.Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/bloom_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Bloom.Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/bloom_text_primary</item>
    </style>

    <style name="Bloom.Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/bloom_text_secondary</item>
    </style>

    <style name="Bloom.CartImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Bloom.HomeRounded12">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Bloom.HomeRounded16">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Bloom.LuxProfileShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Bloom.SearchRounded12">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Bloom.SearchRounded16">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Bloom.LuxProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">@color/lux_accent</item>
    </style>

    <!-- LUX theme variant, for the LUX screens only -->
    <style name="Theme.Bloom.Lux" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/lux_background</item>
        <item name="colorAccent">@color/lux_accent</item>
        <item name="android:textColorPrimary">@color/lux_text</item>
    </style>

</resources>
