<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Hero Image Background -->
    <ImageView
        android:id="@+id/ivHero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/hero_login_floral"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#20000000"
        app:layout_constraintTop_toTopOf="@id/ivHero"
        app:layout_constraintBottom_toBottomOf="@id/ivHero" />

    <!-- Bottom Content Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="32dp"
        app:cardElevation="24dp"
        android:layout_marginTop="-32dp"
        app:layout_constraintTop_toBottomOf="@id/ivHero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Enter your phone number"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLanguageToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌐 हिंदी"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Input Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">

                    <!-- Google Sign-In Button (Hidden for now, preserving code) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogleLogin"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Continue with Google"
                        android:textAllCaps="false"
                        android:textSize="18sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        app:cornerRadius="30dp"
                        app:icon="@drawable/ic_google"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconSize="24dp"
                        android:textColor="?attr/colorOnSurface"
                        android:backgroundTint="?attr/colorSurface"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp"
                        android:elevation="4dp"
                        android:visibility="gone" />

                    <!-- Truecaller Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTruecallerLogin"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Verify with Truecaller"
                        android:textAllCaps="false"
                        android:textSize="18sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        app:cornerRadius="30dp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="?attr/colorPrimary"
                        android:elevation="4dp" />

                    <!-- Phone Number (Hidden for Customers, Used by Agents) -->
                    <LinearLayout
                        android:id="@+id/llPhoneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="16dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Phone Number"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPhone"
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_s"
                            app:boxBackgroundColor="?attr/colorSurfaceVariant"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="1dp"
                            app:boxStrokeColor="?attr/colorPrimary"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:drawableStart="@drawable/ic_phone"
                                android:drawablePadding="@dimen/spacing_m"
                                android:drawableTint="?attr/colorPrimary"
                                android:fontFamily="@font/work_sans"
                                android:hint="+91 9000000000"
                                android:inputType="phone"
                                android:padding="16dp"
                                android:textColorHint="?attr/colorOnSurfaceVariant" />
                        </com.google.android.material.textfield.TextInputLayout>
                        
                        <TextView
                            android:id="@+id/tvError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:fontFamily="@font/work_sans"
                            android:textColor="@color/orders_urgent"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- OTP Input (Hidden by default) -->
                    <LinearLayout
                        android:id="@+id/llOtpInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="16dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Enter OTP"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilOtp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_s"
                            app:boxBackgroundColor="?attr/colorSurfaceVariant"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="1dp"
                            app:boxStrokeColor="?attr/colorPrimary"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etOtp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:fontFamily="@font/work_sans"
                                android:hint="123456"
                                android:inputType="numberPassword"
                                android:maxLength="6"
                                android:padding="16dp"
                                android:textColorHint="?attr/colorOnSurfaceVariant" />
                        </com.google.android.material.textfield.TextInputLayout>
                        
                        <TextView
                            android:id="@+id/tvOtpError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:fontFamily="@font/work_sans"
                            android:textColor="@color/orders_urgent"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>


                </LinearLayout>

                <!-- Action Button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:backgroundTint="?attr/colorPrimary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Get OTP"
                        android:textColor="?attr/colorSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="28dp" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="?attr/colorSurface"
                        android:visibility="gone" />
                </FrameLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Bottom Links -->
                <LinearLayout
                    android:id="@+id/llBottomLinks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMerchantLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/work_sans"
                        android:text="🛠️ Test: Login as Florist"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:textStyle="italic" />

                    <TextView
                        android:id="@+id/tvAgentLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/work_sans"
                        android:text="🛵 Test: Login as Agent"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:textStyle="italic" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

