<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:ignore="HardcodedText,SmallSp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:background="#FFFFFF"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/spacing_xxl"
                android:layout_height="@dimen/spacing_xxl"
                android:layout_marginStart="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="@dimen/spacing_s"
                android:src="@drawable/ic_arrow_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/home_lux_dark" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Track Delivery"
                android:textColor="@color/home_lux_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/spacing_m"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/btnHelp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="center"
                        android:src="@drawable/ic_help_premium"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Help"
                        app:tint="@color/home_lux_dark" />
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/cvCourierInfo"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Map Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="@dimen/spacing_m"
                android:background="@drawable/bg_bottom_sheet_premium">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/spacing_l"
                    app:cardElevation="0dp">
                    <WebView
                        android:id="@+id/mapWebView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_m"
                    android:layout_gravity="top|center_horizontal"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="@dimen/spacing_l"
                    app:cardElevation="@dimen/spacing_s"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="10dp">
                        <View
                            android:id="@+id/vTimeDot"
                            android:layout_width="@dimen/spacing_s"
                            android:layout_height="@dimen/spacing_s"
                            android:background="@drawable/bg_home_notification_dot"
                            android:backgroundTint="#A82D47" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="ARRIVING IN 12 MINS"
                            android:textColor="@color/home_lux_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Timeline -->
            <LinearLayout
                android:id="@+id/llTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Step 1 -->
                <RelativeLayout
                    android:id="@+id/rlStep1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    <View
                        android:id="@+id/line1Bg"
                        android:layout_width="@dimen/spacing_xxs"
                        android:layout_height="50dp"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="36dp"
                        android:background="#F0F0F0" />
                    <View
                        android:id="@+id/line1"
                        android:layout_width="@dimen/spacing_xxs"
                        android:layout_height="0dp"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="36dp"
                        android:background="#A82D47" />
                    <View
                        android:id="@+id/vRipple1"
                        android:layout_width="@dimen/button_height_small"
                        android:layout_height="@dimen/button_height_small"
                        android:background="@drawable/bg_ripple_ring"
                        android:alpha="0" />
                    <ImageView
                        android:id="@+id/ivStatus1"
                        android:layout_width="@dimen/button_height_small"
                        android:layout_height="@dimen/button_height_small"
                        android:background="@drawable/bg_home_notification_dot"
                        android:backgroundTint="#A82D47"
                        android:padding="@dimen/spacing_s"
                        app:tint="#FFFFFF"
                        android:src="@drawable/ic_timeline_placed" />
                    <TextView
                        android:id="@+id/tvStatus1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_toEndOf="@id/ivStatus1"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Order Placed"
                        android:textColor="@color/home_lux_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvStatus1Desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvStatus1Title"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="3dp"
                        android:layout_toEndOf="@id/ivStatus1"
                        android:fontFamily="@font/work_sans"
                        android:text="We've received your order"
                        android:textColor="#888888"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvStatus1Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="@font/work_sans"
                        android:text="09:15 AM"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp" />
                </RelativeLayout>

                <!-- Step 2 -->
                <RelativeLayout
                    android:id="@+id/rlStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    <View
                        android:id="@+id/line2Bg"
                        android:layout_width="@dimen/spacing_xxs"
                        android:layout_height="50dp"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="36dp"
                        android:background="#F0F0F0" />
                    <View
                        android:id="@+id/line2"
                        android:layout_width="@dimen/spacing_xxs"
                        android:layout_height="0dp"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="36dp"
                        android:background="#A82D47" />
                    <View
                        android:id="@+id/vRipple2"
                        android:layout_width="@dimen/button_height_small"
                        android:layout_height="@dimen/button_height_small"
                        android:background="@drawable/bg_ripple_ring"
                        android:alpha="0" />
                    <ImageView
                        android:id="@+id/ivStatus2"
                        android:layout_width="@dimen/button_height_small"
                        android:layout_height="@dimen/button_height_small"
                        android:background="@drawable/bg_home_notification_dot"
                        android:backgroundTint="#A82D47"
                        android:padding="@dimen/spacing_s"
                        app:tint="#FFFFFF"
                        android:src="@drawable/ic_timeline_confirmed" />
                    <TextView
                        android:id="@+id/tvStatus2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_toEndOf="@id/ivStatus2"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Confirmed"
                        android:textColor="@color/home_lux_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvStatus2Desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvStatus2Title"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="3dp"
                        android:layout_toEndOf="@id/ivStatus2"
                        android:fontFamily="@font/work_sans"
                        android:text="Seller has accepted your request"
                        android:textColor="#888888"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvStatus2Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="@font/work_sans"
                        android:text="09:22 AM"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp" />
                </RelativeLayout>

                <!-- Step 3 -->
                <RelativeLayout
                    android:id="@+id/rlStep3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    <View
                        android:id="@+id/line3Bg"
                        android:layout_width="@dimen/spacing_xxs"
                        android:layout_height="50dp"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="36dp"
                        android:background="#F0F0F0" />
                    <View
                        android:id="@+id/line3"
                        android:layout_width="@dimen/spacing_xxs"
                        android:layout_height="0dp"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="36dp"
                        android:background="#A82D47" />
                    <View
                        android:id="@+id/vRipple3"
                        android:layout_width="@dimen/button_height_small"
                        android:layout_height="@dimen/button_height_small"
                        android:background="@drawable/bg_ripple_ring"
                        android:alpha="0" />
                    <ImageView
                        android:id="@+id/ivStatus3"
                        android:layout_width="@dimen/button_height_small"
                        android:layout_height="@dimen/button_height_small"
                        android:background="@drawable/bg_home_notification_dot"
                        android:backgroundTint="#A82D47"
                        android:padding="@dimen/spacing_s"
                        android:src="@drawable/ic_timeline_preparing"
                        app:tint="#FFFFFF" />
                    <TextView
                        android:id="@+id/tvStatus3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_toEndOf="@id/ivStatus3"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Preparing Your Bouquet"
                        android:textColor="@color/home_lux_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvStatus3Desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvStatus3Title"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="3dp"
                        android:layout_toEndOf="@id/ivStatus3"
                        android:fontFamily="@font/work_sans"
                        android:text="Florist is hand-picking fresh blooms"
                        android:textColor="#888888"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvStatus3Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="@font/work_sans"
                        android:text="09:45 AM"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp" />
                </RelativeLayout>

                <!-- Step 4 Highlighted -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvStep4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    app:cardBackgroundColor="#FCFCFC"
                    app:cardCornerRadius="@dimen/spacing_m"
                    app:cardElevation="0dp"
                    app:strokeColor="#FEE9EE"
                    app:strokeWidth="1.2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/spacing_l"
                        android:clipChildren="false"
                        android:clipToPadding="false">
                        <View
                            android:id="@+id/vRipple4"
                            android:layout_width="@dimen/button_height_small"
                            android:layout_height="@dimen/button_height_small"
                            android:background="@drawable/bg_ripple_ring"
                            android:alpha="0" />
                        <ImageView
                            android:id="@+id/ivStatus4"
                            android:layout_width="@dimen/button_height_small"
                            android:layout_height="@dimen/button_height_small"
                            android:background="@drawable/bg_home_notification_dot"
                            android:backgroundTint="#A82D47"
                            android:padding="@dimen/spacing_s"
                            android:src="@drawable/ic_timeline_out"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:id="@+id/tvStatus4Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:layout_toEndOf="@id/ivStatus4"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Out for Delivery"
                            android:textColor="#A82D47"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvStatus4Title"
                            android:layout_marginStart="18dp"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:layout_toEndOf="@id/ivStatus4"
                            android:fontFamily="@font/work_sans"
                            android:text="David R. is nearby with your flowers"
                            android:textColor="#666666"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/dm_sans"
                            android:text="JUST NOW"
                            android:textColor="#A82D47"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:layout_below="@id/ivStatus4"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:background="@drawable/bg_input_pill_lux"
                            android:backgroundTint="#FAFAFA"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/spacing_m">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="DELIVERY OTP"
                                android:textColor="#999999"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvOtp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:letterSpacing="0.2"
                                android:text="--- ---"
                                android:textColor="#A82D47"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step 5 -->
                <RelativeLayout
                    android:id="@+id/rlStep5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:alpha="0.4"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    <View
                        android:id="@+id/vRipple5"
                        android:layout_width="@dimen/button_height_small"
                        android:layout_height="@dimen/button_height_small"
                        android:background="@drawable/bg_ripple_ring"
                        android:alpha="0" />
                    <ImageView
                        android:id="@+id/ivStatus5"
                        android:layout_width="@dimen/button_height_small"
                        android:layout_height="@dimen/button_height_small"
                        android:background="@drawable/bg_home_notification_dot"
                        android:backgroundTint="#F8F8F8"
                        android:padding="@dimen/spacing_s"
                        android:src="@drawable/ic_timeline_delivered"
                        app:tint="#CCCCCC" />
                    <TextView
                        android:id="@+id/tvStatus5Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_toEndOf="@id/ivStatus5"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Delivered"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvStatus5Desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvStatus5Title"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="3dp"
                        android:layout_toEndOf="@id/ivStatus5"
                        android:fontFamily="@font/work_sans"
                        android:text="Expect a knock at your door soon"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />
                </RelativeLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelOrder"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:text="Cancel Order"
                    android:textAllCaps="false"
                    android:textColor="#AF314A"
                    android:visibility="gone" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvCourierInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_m"
        android:visibility="gone"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/spacing_l"
        app:cardElevation="@dimen/spacing_m"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_m">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="@dimen/spacing_xxl"
                android:layout_height="@dimen/spacing_xxl"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_home_person"
                app:shapeAppearanceOverlay="@style/Bloom.HomeRounded12"
                app:tint="#999999" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:text="DELIVERY PARTNER"
                    android:textColor="#AAAAAA"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCourierName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="David R."
                    android:textColor="@color/home_lux_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/work_sans"
                    android:text="4.9 (250+ deliveries)"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCall"
                android:layout_width="@dimen/button_height_small"
                android:layout_height="@dimen/button_height_small"
                android:background="@drawable/bg_circle_translucent"
                android:backgroundTint="#F2F8F4"
                android:contentDescription="Call Courier"
                android:src="@android:drawable/ic_menu_call"
                app:tint="#4A7C59" />

            <ImageButton
                android:id="@+id/btnChat"
                android:layout_width="@dimen/button_height_small"
                android:layout_height="@dimen/button_height_small"
                android:layout_marginStart="@dimen/spacing_s"
                android:background="@drawable/bg_circle_translucent"
                android:backgroundTint="#FEE9EE"
                android:contentDescription="Message Courier"
                android:src="@android:drawable/stat_notify_chat"
                app:tint="#A82D47" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
