<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cart_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_72sdp"
        android:background="@color/cart_background"
        android:elevation="@dimen/_2sdp"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:title="">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/_16sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="@dimen/_12sdp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/cart_on_surface" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Shopping Cart"
            android:textColor="@color/cart_on_surface"
            android:textSize="@dimen/_26ssp"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cartScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/_20sdp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:id="@+id/cartContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_16sdp"
            android:paddingTop="@dimen/_24sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingBottom="@dimen/_28sdp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCartItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <LinearLayout
                android:id="@+id/promoRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_56sdp"
                android:layout_marginTop="@dimen/_24sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPromoCode"
                    android:layout_width="@dimen/_240sdp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:background="@drawable/bg_cart_promo_input"
                    android:fontFamily="@font/work_sans"
                    android:hint="Promo code"
                    android:inputType="text"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    android:singleLine="true"
                    android:textColor="@color/cart_on_surface"
                    android:textColorHint="@color/cart_outline"
                    android:textSize="@dimen/_17ssp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyPromo"
                    android:layout_width="@dimen/_88sdp"
                    android:layout_height="match_parent"
                    android:backgroundTint="@color/cart_cta"
                    android:elevation="@dimen/_4sdp"
                    android:fontFamily="@font/dm_sans"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0.08"
                    android:text="APPLY"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/_16sdp" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_176sdp"
                android:layout_marginTop="@dimen/_24sdp"
                android:background="@drawable/bg_cart_summary_card"
                android:paddingStart="@dimen/_24sdp"
                android:paddingTop="@dimen/_24sdp"
                android:paddingEnd="@dimen/_24sdp"
                android:paddingBottom="@dimen/_24sdp">

                <TextView
                    android:id="@+id/tvSubtotalLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/work_sans"
                    android:text="Subtotal"
                    android:textColor="@color/cart_on_surface_variant"
                    android:textSize="@dimen/_18ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSubtotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/work_sans"
                    android:text="$92.50"
                    android:textColor="@color/cart_on_surface"
                    android:textSize="@dimen/_18ssp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvSubtotalLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvDeliveryFeeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24sdp"
                    android:fontFamily="@font/work_sans"
                    android:text="Delivery Fee"
                    android:textColor="@color/cart_on_surface_variant"
                    android:textSize="@dimen/_18ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSubtotalLabel" />

                <TextView
                    android:id="@+id/tvDeliveryFeeAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/work_sans"
                    android:text="$5.00"
                    android:textColor="@color/cart_on_surface"
                    android:textSize="@dimen/_18ssp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvDeliveryFeeLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/summaryDivider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/_28sdp"
                    android:background="@color/cart_outline_variant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDeliveryFeeLabel" />

                <TextView
                    android:id="@+id/tvTotalLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Total"
                    android:textColor="@color/cart_on_surface"
                    android:textSize="@dimen/_20ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="$97.50"
                    android:textColor="@color/cart_primary"
                    android:textSize="@dimen/_26ssp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvTotalLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cart_checkout_surface"
        android:elevation="@dimen/_10sdp"
        android:orientation="vertical"
        android:paddingStart="@dimen/_16sdp"
        android:paddingTop="@dimen/_16sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:paddingBottom="@dimen/_24sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_64sdp"
            android:backgroundTint="@color/cart_cta"
            android:elevation="@dimen/_8sdp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Proceed to Checkout"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_20ssp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/_16sdp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconPadding="@dimen/_12sdp"
            app:iconTint="@android:color/white" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="@dimen/_72sdp"
            android:background="@drawable/bg_cart_empty_icon"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:text="♡"
            android:textColor="@color/cart_primary"
            android:textSize="@dimen/_32ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Your cart is empty"
            android:textColor="@color/cart_on_surface"
            android:textSize="@dimen/_20ssp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartShopping"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_48sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:backgroundTint="@color/cart_surface_container"
            android:fontFamily="@font/work_sans"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Start Shopping"
            android:textAllCaps="false"
            android:textColor="@color/cart_primary"
            app:cornerRadius="@dimen/_16sdp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
