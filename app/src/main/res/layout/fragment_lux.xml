<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lux_background"
    tools:context=".customer.ui.lux.LuxFragment">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/spacing_xxxl"
        android:background="@color/lux_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_s"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_s"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="@dimen/spacing_xxl"
            android:layout_height="@dimen/spacing_xxl" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLuxTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display"
                android:includeFontPadding="false"
                android:text="LUX"
                android:textColor="@color/lux_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <View
                android:layout_width="@dimen/spacing_xl"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_lux_gold_underline" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCart"
            android:layout_width="@dimen/spacing_xxl"
            android:layout_height="@dimen/spacing_xxl"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cart"
            android:padding="@dimen/spacing_s"
            android:src="@drawable/ic_cart"
            app:tint="@color/lux_accent" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/luxScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.bloom.customer.ui.common.AspectRatioConstraintLayout
                android:id="@+id/heroSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/lux_background"
                app:bloomHeightRatio="618"
                app:bloomWidthRatio="420">

                <ImageView
                    android:id="@+id/ivHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Winter collection floral arrangement"
                    android:scaleType="centerCrop"
                    android:src="@drawable/lux_hero_winter_collection" />

                <View
                    android:id="@+id/heroBottomScrim"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_210sdp"
                    android:background="@drawable/bg_lux_hero_bottom_gradient"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <LinearLayout
                    android:id="@+id/heroTextGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_m"
                    android:paddingEnd="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_xl"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.2"
                        android:lineHeight="@dimen/_16ssp"
                        android:text="EXCLUSIVELY CURATED"
                        android:textAllCaps="true"
                        android:textColor="@color/lux_accent"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:fontFamily="@font/playfair_display"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_38ssp"
                        android:text="The Winter Collection"
                        android:textColor="@color/lux_text"
                        android:textSize="@dimen/_32ssp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:fontFamily="@font/work_sans"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_20ssp"
                        android:text="Curated by Amélie Laurent"
                        android:textColor="@color/lux_text_muted"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="italic" />

                </LinearLayout>

            </com.bloom.customer.ui.common.AspectRatioConstraintLayout>

            <LinearLayout
                android:id="@+id/productSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_m"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingEnd="@dimen/spacing_m">

                <LinearLayout
                    android:id="@+id/productNoir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical">

                    <com.bloom.customer.ui.common.AspectRatioConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lux_image_border"
                        app:bloomHeightRatio="5"
                        app:bloomWidthRatio="4">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:contentDescription="Noir Éclat"
                            android:scaleType="centerCrop"
                            android:src="@drawable/lux_product_noir_eclat"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </com.bloom.customer.ui.common.AspectRatioConstraintLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:fontFamily="@font/playfair_display"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_30ssp"
                        android:text="Noir Éclat"
                        android:textColor="@color/lux_text"
                        android:textSize="@dimen/_24ssp"
                        android:textStyle="normal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_l"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/spacing_l"
                        android:fontFamily="@font/work_sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_24ssp"
                        android:text="A sculptural masterpiece of rare black\ncalla lilies"
                        android:textColor="@color/lux_text_muted"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.01"
                        android:lineHeight="@dimen/_26ssp"
                        android:text="₹285.00"
                        android:textColor="@color/lux_accent"
                        android:textSize="@dimen/_18ssp" />

                    <View
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="1dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:background="@drawable/bg_lux_product_meta_line" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.1"
                        android:lineHeight="@dimen/_16ssp"
                        android:text="ONLY 4 LEFT TODAY"
                        android:textColor="@color/lux_accent"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/productAura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_40sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical">

                    <com.bloom.customer.ui.common.AspectRatioConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lux_image_border"
                        app:bloomHeightRatio="5"
                        app:bloomWidthRatio="4">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:contentDescription="Aura Blush"
                            android:scaleType="centerCrop"
                            android:src="@drawable/lux_product_aura_blush"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </com.bloom.customer.ui.common.AspectRatioConstraintLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:fontFamily="@font/playfair_display"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_30ssp"
                        android:text="Aura Blush"
                        android:textColor="@color/lux_text"
                        android:textSize="@dimen/_24ssp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_l"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/spacing_l"
                        android:fontFamily="@font/work_sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_24ssp"
                        android:text="Ethereal layers of silk-petaled heirloom\npeonies"
                        android:textColor="@color/lux_text_muted"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.01"
                        android:lineHeight="@dimen/_26ssp"
                        android:text="₹340.00"
                        android:textColor="@color/lux_accent"
                        android:textSize="@dimen/_18ssp" />

                    <View
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="1dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:background="@drawable/bg_lux_product_meta_line" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.1"
                        android:lineHeight="@dimen/_16ssp"
                        android:text="LIMITED EDITION"
                        android:textColor="@color/lux_accent"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/productMidnight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_40sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical">

                    <com.bloom.customer.ui.common.AspectRatioConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lux_image_border"
                        app:bloomHeightRatio="5"
                        app:bloomWidthRatio="4">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:contentDescription="Midnight Gilded"
                            android:scaleType="centerCrop"
                            android:src="@drawable/lux_product_midnight_gilded"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </com.bloom.customer.ui.common.AspectRatioConstraintLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:fontFamily="@font/playfair_display"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_30ssp"
                        android:text="Midnight Gilded"
                        android:textColor="@color/lux_text"
                        android:textSize="@dimen/_24ssp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_l"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/spacing_l"
                        android:fontFamily="@font/work_sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_24ssp"
                        android:text="Contrast of wild indigo thistles and\ngilded textures"
                        android:textColor="@color/lux_text_muted"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.01"
                        android:lineHeight="@dimen/_26ssp"
                        android:text="₹215.00"
                        android:textColor="@color/lux_accent"
                        android:textSize="@dimen/_18ssp" />

                    <View
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="1dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:background="@drawable/bg_lux_product_meta_line" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.1"
                        android:lineHeight="@dimen/_16ssp"
                        android:text="ONLY 2 LEFT TODAY"
                        android:textColor="@color/lux_accent"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/quoteSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:paddingBottom="@dimen/_96sdp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_lux_quote_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:fontFamily="@font/playfair_display"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineHeight="@dimen/_30ssp"
                    android:text="&quot;Flowers are the jewelry of a\nroom; they should be as rare and\nintentional as a gemstone.&quot;"
                    android:textColor="@color/lux_text_soft"
                    android:textSize="@dimen/_24ssp"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.3"
                    android:lineHeight="@dimen/_16ssp"
                    android:text="AMÉLIE LAURENT"
                    android:textColor="@color/lux_accent"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
