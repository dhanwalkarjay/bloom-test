<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lux_background"
    tools:context=".customer.ui.lux.LuxFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/Theme.Bloom">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@color/lux_background"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

            <com.bloom.customer.ui.common.AspectRatioConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/lux_background"
                app:bloomHeightRatio="618"
                app:bloomWidthRatio="420"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.5">

                <ImageView
                    android:id="@+id/ivHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/lux_hero_winter_collection" />

                <View
                    android:id="@+id/heroBottomScrim"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_210sdp"
                    android:background="@drawable/bg_lux_hero_bottom_gradient"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <LinearLayout
                    android:id="@+id/heroTextGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_m"
                    android:paddingEnd="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_xl"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans"
                        android:text="EXCLUSIVELY CURATED"
                        android:textColor="@color/lux_accent"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:fontFamily="@font/playfair_display"
                        android:text="The Winter Collection"
                        android:textColor="@color/lux_text"
                        android:textSize="@dimen/_32ssp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:fontFamily="@font/work_sans"
                        android:text="Curated by Amélie Laurent"
                        android:textColor="@color/lux_text_muted"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="italic" />
                </LinearLayout>
            </com.bloom.customer.ui.common.AspectRatioConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                app:layout_collapseMode="pin">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLuxTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/playfair_display"
                            android:includeFontPadding="false"
                            android:text="LUX"
                            android:textColor="@color/lux_text"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="@dimen/spacing_xl"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:background="@drawable/bg_lux_gold_underline" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnCart"
                        android:layout_width="@dimen/spacing_xxl"
                        android:layout_height="@dimen/spacing_xxl"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/spacing_m"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/spacing_s"
                        android:src="@drawable/ic_cart"
                        app:tint="@color/lux_accent" />
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                app:shimmer_auto_start="true"
                app:shimmer_base_color="#333333"
                app:shimmer_highlight_color="#555555"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_m">
                    
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="400dp"
                        android:background="#222222" />
                    <View
                        android:layout_width="150dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="16dp"
                        android:layout_gravity="center"
                        android:background="#222222" />
                    <View
                        android:layout_width="250dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_gravity="center"
                        android:background="#222222" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:paddingHorizontal="@dimen/spacing_m"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:listitem="@layout/item_lux_product"/>

            <LinearLayout
                android:id="@+id/quoteSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:paddingBottom="@dimen/_96sdp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_lux_quote_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:fontFamily="@font/playfair_display"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineHeight="@dimen/_30ssp"
                    android:text="&quot;Flowers are the jewelry of a\nroom; they should be as rare and\nintentional as a gemstone.&quot;"
                    android:textColor="@color/lux_text_soft"
                    android:textSize="@dimen/_24ssp"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.3"
                    android:lineHeight="@dimen/_16ssp"
                    android:text="AMÉLIE LAURENT"
                    android:textColor="@color/lux_accent"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
