<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:ignore="ExtraText">

    <!--
        topBar: wrap_content + minHeight so status-bar inset padding (added dynamically by
        FragmentStatusBar) never squashes the content. paddingTop/Bottom give breathing room.
    -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_56sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:background="@color/home_background"
        android:elevation="@dimen/_2sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_16sdp"
        android:paddingEnd="@dimen/_16sdp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/llLocation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:src="@drawable/ic_home_location" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLocationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:letterSpacing="0.12"
                    android:text="DELIVER TO"
                    android:textColor="@color/home_on_surface_variant"
                    android:textSize="@dimen/_10ssp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCurrentLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:maxLines="1"
                        android:text="New York, NY"
                        android:textColor="@color/home_on_surface"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:src="@drawable/ic_home_arrow_down" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp">

            <ImageView
                android:id="@+id/ivCart"
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/ic_home_notification" />

            <View
                android:layout_width="@dimen/_7sdp"
                android:layout_height="@dimen/_7sdp"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/_9sdp"
                android:layout_marginEnd="@dimen/_9sdp"
                android:background="@drawable/bg_home_notification_dot" />

        </FrameLayout>

    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_120sdp">

                <!-- Category filter chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_64sdp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipAll"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_44sdp"
                            android:background="@drawable/bg_home_chip_active"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:gravity="center"
                            android:text="@string/filter_all"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_15ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipBirthday"
                            android:layout_width="@dimen/_112sdp"
                            android:layout_height="@dimen/_44sdp"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:background="@drawable/bg_home_chip_inactive"
                            android:fontFamily="@font/work_sans"
                            android:gravity="center"
                            android:text="@string/filter_birthday"
                            android:textColor="@color/home_on_surface_variant"
                            android:textSize="@dimen/_15ssp" />

                        <TextView
                            android:id="@+id/chipAnniversary"
                            android:layout_width="@dimen/_132sdp"
                            android:layout_height="@dimen/_44sdp"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:background="@drawable/bg_home_chip_inactive"
                            android:fontFamily="@font/work_sans"
                            android:gravity="center"
                            android:text="@string/filter_anniversary"
                            android:textColor="@color/home_on_surface_variant"
                            android:textSize="@dimen/_15ssp" />

                        <TextView
                            android:id="@+id/chipSympathy"
                            android:layout_width="@dimen/_124sdp"
                            android:layout_height="@dimen/_44sdp"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:background="@drawable/bg_home_chip_inactive"
                            android:fontFamily="@font/work_sans"
                            android:gravity="center"
                            android:text="@string/filter_sympathy"
                            android:textColor="@color/home_on_surface_variant"
                            android:textSize="@dimen/_15ssp" />

                        <TextView
                            android:id="@+id/chipCongratulations"
                            android:layout_width="@dimen/_168sdp"
                            android:layout_height="@dimen/_44sdp"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:background="@drawable/bg_home_chip_inactive"
                            android:fontFamily="@font/work_sans"
                            android:gravity="center"
                            android:text="@string/filter_congratulations"
                            android:textColor="@color/home_on_surface_variant"
                            android:textSize="@dimen/_15ssp" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Hero Banner -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_188sdp"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_16sdp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivHeroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/home_hero_spring_sale"
                        app:shapeAppearanceOverlay="@style/Bloom.HomeRounded12" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_home_hero_overlay" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_28sdp"
                        android:paddingEnd="@dimen/_24sdp"
                        android:paddingBottom="@dimen/_28sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Spring Awakening Sale"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_24ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:fontFamily="@font/work_sans"
                            android:text="Save up to 30% on seasonal favorites"
                            android:textColor="#EFFFFFFF"
                            android:textSize="@dimen/_14ssp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShopCollection"
                            android:layout_width="@dimen/_196sdp"
                            android:layout_height="@dimen/_56sdp"
                            android:layout_marginTop="@dimen/_16sdp"
                            android:backgroundTint="@color/home_primary"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Shop Collection"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_17ssp"
                            android:textStyle="bold"
                            app:cornerRadius="@dimen/_12sdp" />

                    </LinearLayout>
                </FrameLayout>

                <!-- Lux promo card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/luxPromo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_108sdp"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:background="@drawable/bg_home_lux_card"
                    android:elevation="@dimen/_8sdp"
                    android:paddingStart="@dimen/_18sdp"
                    android:paddingTop="@dimen/_18sdp"
                    android:paddingEnd="@dimen/_18sdp"
                    android:paddingBottom="@dimen/_18sdp">

                    <LinearLayout
                        android:id="@+id/luxTextGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/luxArrowCircle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:src="@drawable/ic_home_flare"
                                app:tint="@color/home_lux_gold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:fontFamily="@font/dm_sans"
                                android:letterSpacing="0.2"
                                android:text="CURATED LUXURY"
                                android:textColor="@color/home_lux_gold"
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:fontFamily="@font/playfair_display"
                            android:lineSpacingMultiplier="1.15"
                            android:text="Discover LUX —&#10;Premium Blooms"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_20ssp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/luxArrowCircle"
                        android:layout_width="@dimen/_56sdp"
                        android:layout_height="@dimen/_56sdp"
                        android:background="@drawable/bg_home_lux_arrow_circle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/home_lux_gold" />

                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Seasonal Favorites section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_28sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/work_sans"
                        android:text="Seasonal Favorites"
                        android:textColor="@color/home_on_surface"
                        android:textSize="@dimen/_18ssp" />

                    <TextView
                        android:id="@+id/tvViewAllSeasonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="View All"
                        android:textColor="@color/home_primary"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSeasonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_product" />

                <!-- Bestsellers section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_28sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/work_sans"
                        android:text="Bestsellers"
                        android:textColor="@color/home_on_surface"
                        android:textSize="@dimen/_18ssp" />

                    <TextView
                        android:id="@+id/tvViewAllBestsellers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="View All"
                        android:textColor="@color/home_primary"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBestsellers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_product" />

                <!-- Shops RecyclerView (full-width, vertical) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvShops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="visible"
                    tools:listitem="@layout/item_shop" />

                <!-- Login prompt (shown when logged out) -->
                <LinearLayout
                    android:id="@+id/llLoginPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_32sdp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/discover_florists"
                        android:textColor="@color/home_on_surface"
                        android:textSize="@dimen/_20ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:fontFamily="@font/work_sans"
                        android:gravity="center"
                        android:text="@string/login_to_view_shops"
                        android:textColor="@color/home_on_surface_variant"
                        android:textSize="@dimen/_15ssp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="@dimen/_160sdp"
                        android:layout_height="@dimen/_56sdp"
                        android:layout_marginTop="@dimen/_24sdp"
                        android:backgroundTint="@color/home_primary"
                        android:text="@string/login_signup"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        app:cornerRadius="@dimen/_12sdp" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_32sdp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Service coming soon!"
                        android:textColor="@color/home_on_surface"
                        android:textSize="@dimen/_20ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmptySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:fontFamily="@font/work_sans"
                        android:text="We haven't reached your city yet."
                        android:textColor="@color/home_on_surface_variant"
                        android:textSize="@dimen/_15ssp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
