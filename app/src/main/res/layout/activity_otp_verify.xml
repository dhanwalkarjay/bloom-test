<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- Hero Image Background Header -->
            <ImageView
                android:id="@+id/ivHero"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:scaleType="centerCrop"
                android:src="@drawable/otp_hero"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />



            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_circle_translucent"
                android:backgroundTint="#40FFFFFF"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/colorPrimary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Main Content Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bottom_sheet_premium"
                android:paddingHorizontal="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/ivHero"
                android:layout_marginTop="-40dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Verification Code"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/work_sans"
                    android:text="Please enter the 6-digit code sent to your phone number."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.2"/>

                <!-- 6-Box OTP Input Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- Box 1 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardOtp1"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="1dp">
                            <TextView
                                android:id="@+id/tvOtp1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Box 2 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardOtp2"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="1dp">
                            <TextView
                                android:id="@+id/tvOtp2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Box 3 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardOtp3"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="1dp">
                            <TextView
                                android:id="@+id/tvOtp3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Box 4 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardOtp4"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="1dp">
                            <TextView
                                android:id="@+id/tvOtp4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Box 5 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardOtp5"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="1dp">
                            <TextView
                                android:id="@+id/tvOtp5"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Box 6 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardOtp6"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="1dp">
                            <TextView
                                android:id="@+id/tvOtp6"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Invisible overlay EditText to capture input natively -->
                    <EditText
                        android:id="@+id/etOtpInvisible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:cursorVisible="false"
                        android:inputType="number"
                        android:maxLength="6"
                        android:textColor="@android:color/transparent"
                        android:importantForAutofill="yes"
                        android:autofillHints="smsOTPCode" />

                </FrameLayout>

                <!-- Error Message -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/work_sans"
                    android:textColor="@color/orders_urgent"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Invalid OTP code entered." />

                <!-- Timer & Resend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/work_sans"
                        android:text="Didn't receive it? "
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvResend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Resend in 0:30"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- Action Button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp">
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerify"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:backgroundTint="?attr/colorPrimary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Verify &amp; Continue"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="28dp" />
                        
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:indeterminateTint="?attr/colorOnPrimary" />
                </FrameLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
