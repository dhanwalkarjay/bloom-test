<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".customer.ui.product.ProductDetailActivity">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/productScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/spacing_l">

            <!-- Hero Image Carousel (Edge to Edge) -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpProductGallery"
                android:layout_width="match_parent"
                android:layout_height="480dp"
                android:background="#F5F5F5"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Gradient Scrim for better indicator visibility -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_bottom_black_scrim"
                app:layout_constraintBottom_toBottomOf="@id/vpProductGallery" />

            <!-- Dot Indicator -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabIndicator"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginBottom="44dp"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="@id/vpProductGallery"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tabBackground="@drawable/tab_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabPaddingEnd="8dp"
                app:tabPaddingStart="8dp"
                app:tabRippleColor="@null" />

            <!-- Details Overlapping Container (Bottom Sheet Style) -->
            <LinearLayout
                android:id="@+id/llDetailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-32dp"
                android:background="@drawable/bg_bottom_sheet_premium"
                android:elevation="@dimen/spacing_s"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_xl"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vpProductGallery"
                app:layout_constraintVertical_bias="0.0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProductName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Sunrise Roses"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="₹580"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/spacing_m"
                        android:layout_height="@dimen/spacing_m"
                        android:src="@drawable/ic_search_star"
                        app:tint="#F4B400" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:fontFamily="@font/work_sans"
                        android:text="4.8 (124 reviews)"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Florist Profile Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:background="@drawable/bg_rounded_grey"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_translucent"
                        android:padding="8dp"
                        android:src="@drawable/ic_shop"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Petals &amp; Co. Boutique"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/work_sans"
                            android:text="Premium Artisan Florist"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="View Store"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        app:cornerRadius="20dp"
                        app:strokeColor="?attr/colorPrimary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:fontFamily="@font/work_sans"
                    android:lineSpacingMultiplier="1.4"
                    android:text="A radiant collection of premium roses in warm sunset hues, perfect for brightening any space."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <!-- Options -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Select Size"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_chip_active"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="@dimen/spacing_l"
                        android:paddingVertical="10dp"
                        android:text="Regular"
                        android:textColor="?attr/colorSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:background="@drawable/bg_home_chip_inactive"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="@dimen/spacing_l"
                        android:paddingVertical="10dp"
                        android:text="Deluxe"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Care Instructions -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Care Instructions"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:orientation="horizontal">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_grey"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💧"
                            android:textSize="20sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/work_sans"
                            android:text="Change water\nevery 2 days"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                    </LinearLayout>
                    
                    <Space
                        android:layout_width="@dimen/spacing_s"
                        android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_grey"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✂️"
                            android:textSize="20sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/work_sans"
                            android:text="Trim stems\n1 inch daily"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:orientation="horizontal">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_grey"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="☀️"
                            android:textSize="20sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/work_sans"
                            android:text="Avoid direct\nsunlight"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                    </LinearLayout>
                    
                    <Space
                        android:layout_width="@dimen/spacing_s"
                        android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_grey"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍃"
                            android:textSize="20sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/work_sans"
                            android:text="Use included\nflower food"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Card Message Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Card Message"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    app:boxBackgroundColor="#F5F5F5"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:hintEnabled="false"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCardMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:lines="3"
                        android:background="@null"
                        android:padding="16dp"
                        android:hint="Type your message here..." />
                </com.google.android.material.textfield.TextInputLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:scrollbars="none">
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="false">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipBirthday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Happy Birthday!" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSympathy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="With deepest sympathy" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipThinking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thinking of you" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCongrats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Congratulations!" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/llAttachVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:background="@drawable/bg_rounded_grey"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_s"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/spacing_l"
                        android:layout_height="@dimen/spacing_l"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvVideoStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_weight="1"
                        android:text="Attach Video Message ✨"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                        
                    <ImageView
                        android:id="@+id/btnRemoveVideo"
                        android:layout_width="@dimen/spacing_l"
                        android:layout_height="@dimen/spacing_l"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        app:tint="?attr/colorOutline" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Delivery Information"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:fontFamily="@font/work_sans"
                    android:lineSpacingExtra="6dp"
                    android:text="• Estimated delivery: 2-3 hours\n• Same day delivery available for orders before 4 PM\n• Hand-delivered in signature Bloom wrap"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <!-- Add-ons Section -->
                <TextView
                    android:id="@+id/tvAddonsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Add something extra?"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAddons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_addon" />

            </LinearLayout>

            <!-- Floating Favorite Button perfectly positioned on the boundary -->
            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="@drawable/bg_circle_translucent"
                android:backgroundTint="?attr/colorPrimary"
                android:contentDescription="Favorite"
                android:elevation="@dimen/spacing_s"
                android:src="@drawable/ic_search_heart"
                app:layout_constraintBottom_toTopOf="@id/llDetailsContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/llDetailsContainer"
                app:tint="?attr/colorSurface" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Top Navigation (Over Image) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingTop="38dp"
        android:paddingBottom="@dimen/spacing_m"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/spacing_xxl"
            android:layout_height="@dimen/spacing_xxl"
            android:background="@drawable/bg_circle_translucent"
            android:backgroundTint="#80000000"
            android:contentDescription="Back"
            android:padding="@dimen/spacing_s"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorSurface" />

        <FrameLayout
            android:id="@+id/flCartTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnCartTop"
                android:layout_width="@dimen/spacing_xxl"
                android:layout_height="@dimen/spacing_xxl"
                android:background="@drawable/bg_circle_translucent"
                android:backgroundTint="#80000000"
                android:contentDescription="Cart"
                android:padding="@dimen/spacing_s"
                android:src="@drawable/ic_cart"
                app:tint="?attr/colorSurface" />

            <TextView
                android:id="@+id/tvCartBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_home_notification_dot"
                android:gravity="center"
                android:text="0"
                android:textColor="?attr/colorSurface"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sleek Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="?android:attr/colorBackground"
        android:elevation="@dimen/spacing_l"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_l"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Add to Cart / Stepper -->
        <FrameLayout
            android:id="@+id/flAction"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:animateLayoutChanges="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/bloom_chip_bg"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Add to Cart"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                app:cornerRadius="25dp"
                app:icon="@drawable/ic_cart"
                app:iconGravity="textStart"
                app:iconTint="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:id="@+id/llQuantity"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_chip_active"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnMinus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_remove"
                    app:tint="?attr/colorSurface" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/spacing_l"
                    android:background="#40FFFFFF" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?attr/colorSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/spacing_l"
                    android:background="#40FFFFFF" />

                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_home_add"
                    app:tint="?attr/colorSurface" />
            </LinearLayout>
        </FrameLayout>

        <!-- Buy Now Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckout"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:backgroundTint="?attr/colorPrimary"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Buy Now"
            android:textColor="?attr/colorSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="25dp" />

        <TextView
            android:id="@+id/tvOutOfRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delivery only within 5km of shop"
            android:textColor="@color/orders_urgent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
