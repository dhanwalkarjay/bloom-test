<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Floral Header -->
    <ImageView
        android:id="@+id/ivFloralHeader"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:scaleType="centerCrop"
        android:src="@drawable/floral_header"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="@dimen/spacing_xl"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_m"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="@dimen/spacing_xxl"
            android:layout_height="@dimen/spacing_xxl"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_arrow_back"
            app:tint="#0F172A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Order Confirmed"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Hero Text -->
            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:text="Order Confirmed!"
                android:textColor="#0F172A"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvThankYou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_xl"
                android:layout_marginTop="@dimen/spacing_s"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/spacing_xs"
                android:text="Thank you for your floral\nselection, Eleanor!"
                android:textColor="#334155"
                android:textSize="18sp" />

            <!-- Wreath Checkmark -->
            <ImageView
                android:id="@+id/ivCheck"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_xl"
                android:src="@drawable/floral_wreath_check" />

            <!-- Order Details Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Order Details"
                    android:textColor="#0F172A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Order #1459203 / Oct 26, 2023"
                    android:textColor="#475569"
                    android:textSize="16sp" />

                <!-- Product Card Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:orientation="horizontal">

                    <!-- Outer double border simulation -->
                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp">
                        
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="@dimen/spacing_m"
                            app:cardElevation="0dp"
                            app:strokeColor="#FCA5A5"
                            app:strokeWidth="1dp" />
                        
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_gravity="center"
                            app:cardCornerRadius="@dimen/spacing_s"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/ivProduct"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/home_hero_spring_sale" />
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProductName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="The Midnight Bloom"
                            android:textColor="#0F172A"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProductSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Luxury Bridal Collection"
                            android:textColor="#94A3B8"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvQty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Qty: 1"
                            android:textColor="#0F172A"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvProductPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Price: $189.00"
                            android:textColor="#0F172A"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Shipping Address -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Shipping Address:"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvShippingAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Eleanor Vance\n742 Maple Avenue, Apt 4B\nNew York, NY 10011"
                    android:textColor="#334155"
                    android:textSize="16sp" />

                <!-- Payment Method -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Payment Method:"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Visa ending in 4210"
                    android:textColor="#334155"
                    android:textSize="16sp" />

                <!-- Order Summary -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Order Summary"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Subtotal Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Subtotal"
                        android:textColor="#334155"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="($189.00)"
                        android:textColor="#334155"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Delivery Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Delivery"
                        android:textColor="#334155"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvDeliveryFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="($15.00)"
                        android:textColor="#334155"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Tax Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Tax"
                        android:textColor="#334155"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvTax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="($16.32)"
                        android:textColor="#334155"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Total Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Total:"
                        android:textColor="#0F172A"
                        android:textStyle="bold"
                        android:textSize="20sp" />
                    <TextView
                        android:id="@+id/tvTotalPaid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="$220.32"
                        android:textColor="#0F172A"
                        android:textStyle="bold"
                        android:textSize="20sp" />
                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrackOrder"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginHorizontal="@dimen/spacing_l"
                android:layout_marginTop="@dimen/spacing_xl"
                android:backgroundTint="#9C273E"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Track Your Order"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:elevation="@dimen/spacing_s"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadInvoice"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginHorizontal="@dimen/spacing_l"
                android:layout_marginTop="@dimen/spacing_m"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#0F172A"
                app:strokeWidth="1dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Download PDF Invoice"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconTint="#0F172A"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendToAnother"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginHorizontal="@dimen/spacing_l"
                android:layout_marginTop="@dimen/spacing_m"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#9C273E"
                app:strokeWidth="1dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Send to another recipient"
                android:textAllCaps="false"
                android:textColor="#9C273E"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

            <LinearLayout
                android:id="@+id/llFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_xl"
                android:layout_marginTop="@dimen/spacing_l"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A confirmation email is on its way to eleanor.v@mail.com."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:id="@+id/tvEstimatedDelivery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Delivery: Oct 28, 2023."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
