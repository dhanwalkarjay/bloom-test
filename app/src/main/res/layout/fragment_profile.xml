<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bloom_background">

    <!-- Premium Edge-to-Edge Header Background -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_profile_gradient"
        app:layout_constraintHeight_percent="0.30"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/scrollContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Profile Info Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:paddingHorizontal="24dp">

                <FrameLayout
                    android:id="@+id/flAvatarContainer"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="60dp"
                        app:cardElevation="12dp"
                        app:strokeColor="@android:color/white"
                        app:strokeWidth="4dp">

                        <ImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_home_person" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Glassmorphism Edit Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="#40FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="16dp"
                        app:strokeColor="@android:color/white"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="@android:color/black" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/flAvatarContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flAvatarContainer"
                    app:layout_constraintTop_toTopOf="@id/flAvatarContainer">

                    <TextView
                        android:id="@+id/tvFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Test User"
                        android:textColor="@android:color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="test@bloom.com"
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- First Group (Overlapping gradient) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <include
                        android:id="@+id/itemAddresses"
                        layout="@layout/item_profile_menu"
                        app:icon="@drawable/ic_home_location"
                        app:title="Saved Addresses" />

                    <include
                        android:id="@+id/itemPayment"
                        layout="@layout/item_profile_menu"
                        app:icon="@drawable/ic_orders_payments"
                        app:title="Payment Methods" />

                    <include
                        android:id="@+id/itemLanguage"
                        layout="@layout/item_profile_menu"
                        app:icon="@drawable/ic_search_tune"
                        app:subtitle="English"
                        app:title="Language" />

                    <include
                        android:id="@+id/itemCurrency"
                        layout="@layout/item_profile_menu"
                        app:icon="@drawable/ic_orders_payments"
                        app:subtitle="INR"
                        app:title="Currency" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Second Group -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <include
                        android:id="@+id/itemNotifications"
                        layout="@layout/item_profile_menu"
                        app:icon="@drawable/ic_home_notification"
                        app:title="Notifications" />

                    <include
                        android:id="@+id/itemHistory"
                        layout="@layout/item_profile_menu"
                        app:icon="@drawable/ic_orders_receipt"
                        app:title="Order History" />

                    <include
                        android:id="@+id/itemHelp"
                        layout="@layout/item_profile_menu"
                        app:icon="@drawable/ic_lux_menu"
                        app:title="Help &amp; Support" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Premium Logout Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvLogout"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/home_lux_dark"
                app:cardCornerRadius="32dp"
                app:cardElevation="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Sign Out"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@android:color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Bloom Premium Edition v0.0.1"
                android:textColor="#999999"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
