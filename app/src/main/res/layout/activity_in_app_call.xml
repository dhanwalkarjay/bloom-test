<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_call_gradient" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:fontFamily="@font/dm_sans"
        android:text="Calling via Bloom..."
        android:textColor="#B3FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Pulse Rings -->
    <View
        android:id="@+id/pulseRing2"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_pulse_ring"
        app:layout_constraintBottom_toBottomOf="@id/cvProfile"
        app:layout_constraintEnd_toEndOf="@id/cvProfile"
        app:layout_constraintStart_toStartOf="@id/cvProfile"
        app:layout_constraintTop_toTopOf="@id/cvProfile" />

    <View
        android:id="@+id/pulseRing1"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_pulse_ring"
        app:layout_constraintBottom_toBottomOf="@id/cvProfile"
        app:layout_constraintEnd_toEndOf="@id/cvProfile"
        app:layout_constraintStart_toStartOf="@id/cvProfile"
        app:layout_constraintTop_toTopOf="@id/cvProfile" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvProfile"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="48dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="16dp"
        app:strokeWidth="4dp"
        app:strokeColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatus">

        <ImageView
            android:id="@+id/ivShopProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvShopName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/playfair_display"
        android:text="The Floral Studio"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvProfile" />

    <!-- Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            app:backgroundTint="#33FFFFFF"
            app:elevation="0dp"
            app:tint="#FFFFFF"
            android:src="@drawable/ic_mic" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnEndCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="#FF3B30"
            app:elevation="8dp"
            app:tint="#FFFFFF"
            app:fabCustomSize="72dp"
            app:maxImageSize="36dp"
            android:src="@drawable/ic_call_end" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSpeaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            app:backgroundTint="#33FFFFFF"
            app:elevation="0dp"
            app:tint="#FFFFFF"
            android:src="@drawable/ic_volume_up" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
