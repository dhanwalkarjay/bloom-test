<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Circle background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <size android:width="56dp" android:height="56dp"/>
            <!-- Add a slight stroke/shadow illusion -->
            <stroke android:width="1dp" android:color="#CCCCCC"/>
        </shape>
    </item>
    <!-- Double arrow icon inside the circle -->
    <item android:gravity="center" android:width="24dp" android:height="24dp">
        <vector android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
            <path
                android:fillColor="#757575"
                android:pathData="M8,5 L15,12 L8,19 M12,5 L19,12 L12,19" />
        </vector>
    </item>
</layer-list>
