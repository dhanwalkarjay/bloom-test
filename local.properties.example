## Bloom API Keys — Copy this file to 'local.properties' and fill in real values
## DO NOT commit local.properties to version control

sdk.dir=/path/to/Android/Sdk

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co/
SUPABASE_ANON_KEY=your_anon_key_here

# Razorpay (publishable key only — NEVER put the secret here)
RAZORPAY_KEY_ID=rzp_test_your_key_here

# Google Maps
MAPS_API_KEY=AIzaSy_your_key_here
